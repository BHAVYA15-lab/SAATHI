# Saathi FastAPI Backend Environment Variables Template

# JWT Secret Key (Generate a fresh key using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_this_with_a_generated_random_string

# Database Connection URL
# SQLite Default: sqlite:///./saarthi.db
# PostgreSQL Example: postgresql://user:password@ep-xyz.neon.tech/saathi?sslmode=require
DATABASE_URL=sqlite:///./saarthi.db

# Allowed CORS Origins (comma-separated URLs, no wildcards in production)
# Local: http://localhost:5173,http://127.0.0.1:5173
# Production Example: https://saathi-health.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
